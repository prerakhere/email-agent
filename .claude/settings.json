{
  "permissions": {
    "deny": [
      "Read(./credentials.json)",
      "Read(./token*.json)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./local.settings.json)",
      "Edit(./credentials.json)",
      "Edit(./token*.json)",
      "Bash(cat *credentials*)",
      "Bash(cat *token*.json*)",
      "Bash(cat *.env*)",
      "Bash(grep * credentials.json*)",
      "Bash(head * credentials.json*)",
      "Bash(tail * credentials.json*)",
      "Read(~/.google_workspace_mcp/**)",
      "Edit(~/.google_workspace_mcp/**)",
      "Bash(cat *google_workspace_mcp*)",
      "Bash(ls *google_workspace_mcp/credentials*)"
    ],
    "ask": [
      "Bash(git commit *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff_format.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log_commit.sh"
          }
        ]
      }
    ]
  }
}
